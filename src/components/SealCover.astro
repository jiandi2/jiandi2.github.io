---
const {sealTitle,guest,episodeNumber,color='#315f52',tint='#e7eee9',wide=false}=Astro.props;const c=Array.from(sealTitle.padEnd(4,' '));
---
<div class:list={['seal',{wide}]} style={`--seal:${color};--tint:${tint}`}><svg viewBox="0 0 640 760" role="img" aria-label={`${sealTitle}，${guest}`}><rect width="640" height="760" fill="var(--tint)"/><path d="M56 55h528v650H56zM86 84h468v592H86z" fill="none" stroke="var(--seal)" opacity=".28"/><text x="80" y="120" class="meta">经邦论策 · 第 {episodeNumber} 期</text><g class="title"><text x="246" y="300">{c[0]}</text><text x="394" y="300">{c[1]}</text><text x="246" y="448">{c[2]}</text><text x="394" y="448">{c[3]}</text></g><line x1="226" y1="500" x2="414" y2="500" stroke="var(--seal)"/><text x="320" y="568" class="guest">{guest}</text><text x="320" y="615" class="meta center">JIANDI · INSIGHTS</text><rect x="490" y="622" width="70" height="70" fill="var(--seal)"/><text x="525" y="666" class="mark">见地</text></svg></div>
<style>.seal{aspect-ratio:640/760;overflow:hidden;background:var(--tint)}svg{display:block;width:100%;height:100%}.meta{fill:var(--seal);font:500 16px system-ui;letter-spacing:.18em}.center{text-anchor:middle;font-size:12px}.title text{fill:var(--seal);font:600 112px ui-serif,"Songti SC",serif;text-anchor:middle}.guest{fill:var(--seal);font:500 30px ui-serif,"Songti SC",serif;text-anchor:middle;letter-spacing:.25em}.mark{fill:#fff;font:600 18px ui-serif,"Songti SC",serif;text-anchor:middle}.wide{aspect-ratio:4/3}.wide svg{transform:translateY(-10%) scale(.84)}</style>
