---
import BrandMark from './BrandMark.astro';
const {sealTitle,guest,episodeNumber,color='#315f52',tint='#e7eee9',wide=false,image,imagePosition='50% 40%',imageScale=1.08,priority=false}=Astro.props;const c=Array.from(sealTitle.padEnd(4,' '));
---
<div class:list={['seal',{wide,photo:Boolean(image)}]} style={`--seal:${color};--tint:${tint};--photo-position:${imagePosition};--photo-scale:${imageScale}`}>
  {image?<><img src={image} alt={`${guest}教授`} loading={priority?'eager':'lazy'} fetchpriority={priority?'high':'auto'} width="1080" height="810"/><div class="photo-vignette"></div><div class="type-panel"><span>经邦论策</span><div class="panel-title">{c.map(char=><b>{char}</b>)}</div><i></i><small>第 {episodeNumber} 期</small><em>{guest}</em></div><div class="poster-brand"><BrandMark stacked inverse compact/></div></>:<svg viewBox="0 0 640 760" role="img" aria-label={`${sealTitle}，${guest}`}><rect width="640" height="760" fill="var(--tint)"/><path d="M56 55h528v650H56zM86 84h468v592H86z" fill="none" stroke="var(--seal)" opacity=".28"/><text x="80" y="120" class="meta">经邦论策 · 第 {episodeNumber} 期</text><g class="title"><text x="246" y="300">{c[0]}</text><text x="394" y="300">{c[1]}</text><text x="246" y="448">{c[2]}</text><text x="394" y="448">{c[3]}</text></g><line x1="226" y1="500" x2="414" y2="500" stroke="var(--seal)"/><text x="320" y="568" class="guest">{guest}</text><text x="320" y="615" class="meta center">JIANDI · INSIGHTS</text><rect x="490" y="622" width="70" height="70" fill="var(--seal)"/><text x="525" y="666" class="mark">见地</text></svg>}
</div>
<style>.seal{position:relative;aspect-ratio:640/760;overflow:hidden;background:var(--tint)}svg{display:block;width:100%;height:100%}.meta{fill:var(--seal);font:500 16px system-ui;letter-spacing:.18em}.center{text-anchor:middle;font-size:12px}.title text{fill:var(--seal);font:600 112px ui-serif,"Songti SC",serif;text-anchor:middle}.guest{fill:var(--seal);font:500 30px ui-serif,"Songti SC",serif;text-anchor:middle;letter-spacing:.25em}.mark{fill:#fff;font:600 18px ui-serif,"Songti SC",serif;text-anchor:middle}.wide,.photo{aspect-ratio:4/3}.wide:not(.photo) svg{transform:translateY(-10%) scale(.84)}.photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:var(--photo-position);transform:scale(var(--photo-scale));transform-origin:center}.photo:after{content:"";position:absolute;inset:16px;border:1px solid rgba(255,255,255,.58);pointer-events:none}.photo-vignette{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,14,12,.08) 0%,transparent 40%,rgba(8,14,12,.18) 58%,rgba(8,14,12,.9) 100%)}.type-panel{position:absolute;inset:auto 0 0;padding:0 7% 6.5%;color:#fff;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end}.type-panel>span,.type-panel>small{font:650 9px/1.4 ui-sans-serif,system-ui;letter-spacing:.2em;opacity:.84}.type-panel>small{order:-1;margin-bottom:3px}.panel-title{display:flex;gap:.12em;margin:3px 0 2px;color:#fff}.panel-title b{font:600 clamp(25px,3.4vw,43px)/1.08 ui-serif,"Songti SC",serif;text-shadow:0 2px 16px rgba(0,0,0,.35)}.type-panel i{display:none}.type-panel em{margin-top:5px;color:#fff;font:600 clamp(13px,1.45vw,18px)/1.2 ui-serif,"Songti SC",serif;font-style:normal;letter-spacing:.18em}.poster-brand{position:absolute;left:7%;top:7%;z-index:2;display:flex;align-items:center;justify-content:center;color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,.72)) drop-shadow(0 5px 14px rgba(0,0,0,.38))}</style>
