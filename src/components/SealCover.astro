---
import BrandMark from './BrandMark.astro';
const {sealTitle,guest,episodeNumber,color='#315f52',tint='#e7eee9',wide=false,image,imagePosition='50% 40%',priority=false}=Astro.props;const c=Array.from(sealTitle.padEnd(4,' '));
---
<div class:list={['seal',{wide,photo:Boolean(image)}]} style={`--seal:${color};--tint:${tint};--photo-position:${imagePosition}`}>
  {image?<><img src={image} alt={`${guest}教授`} loading={priority?'eager':'lazy'} fetchpriority={priority?'high':'auto'} width="1080" height="810"/><div class="photo-vignette"></div><div class="type-panel"><span>经邦论策</span><div class="panel-title">{c.map(char=><b>{char}</b>)}</div><i></i><small>第 {episodeNumber} 期</small><em>{guest}</em></div><div class="poster-brand"><BrandMark stacked inverse compact/></div></>:<svg viewBox="0 0 640 760" role="img" aria-label={`${sealTitle}，${guest}`}><rect width="640" height="760" fill="var(--tint)"/><path d="M56 55h528v650H56zM86 84h468v592H86z" fill="none" stroke="var(--seal)" opacity=".28"/><text x="80" y="120" class="meta">经邦论策 · 第 {episodeNumber} 期</text><g class="title"><text x="246" y="300">{c[0]}</text><text x="394" y="300">{c[1]}</text><text x="246" y="448">{c[2]}</text><text x="394" y="448">{c[3]}</text></g><line x1="226" y1="500" x2="414" y2="500" stroke="var(--seal)"/><text x="320" y="568" class="guest">{guest}</text><text x="320" y="615" class="meta center">JIANDI · INSIGHTS</text><rect x="490" y="622" width="70" height="70" fill="var(--seal)"/><text x="525" y="666" class="mark">见地</text></svg>}
</div>
<style>.seal{position:relative;aspect-ratio:640/760;overflow:hidden;background:var(--tint)}svg{display:block;width:100%;height:100%}.meta{fill:var(--seal);font:500 16px system-ui;letter-spacing:.18em}.center{text-anchor:middle;font-size:12px}.title text{fill:var(--seal);font:600 112px ui-serif,"Songti SC",serif;text-anchor:middle}.guest{fill:var(--seal);font:500 30px ui-serif,"Songti SC",serif;text-anchor:middle;letter-spacing:.25em}.mark{fill:#fff;font:600 18px ui-serif,"Songti SC",serif;text-anchor:middle}.wide,.photo{aspect-ratio:4/3}.wide:not(.photo) svg{transform:translateY(-10%) scale(.84)}.photo img{display:block;width:70%;height:100%;object-fit:cover;object-position:var(--photo-position)}.photo:after{content:"";position:absolute;inset:16px;border:1px solid rgba(255,255,255,.58);pointer-events:none}.photo-vignette{position:absolute;inset:0 30% 0 0;background:linear-gradient(180deg,transparent 55%,rgba(9,15,13,.58) 100%)}.type-panel{position:absolute;inset:0 0 0 66%;padding:8% 5.5%;background:var(--seal);color:var(--tint);display:flex;flex-direction:column;align-items:center;justify-content:center}.type-panel>span,.type-panel>small{font:600 9px/1.4 ui-sans-serif,system-ui;letter-spacing:.22em;opacity:.78}.panel-title{display:grid;grid-template-columns:repeat(2,1fr);gap:.05em .17em;margin:12% 0;color:#fff}.panel-title b{font:600 clamp(22px,3.5vw,46px)/1.05 ui-serif,"Songti SC",serif}.type-panel i{width:30px;margin:2% 0 9%;border-top:1px solid rgba(255,255,255,.55)}.type-panel em{margin-top:9%;color:#fff;font:600 clamp(13px,1.45vw,19px)/1.2 ui-serif,"Songti SC",serif;font-style:normal;letter-spacing:.16em}.poster-brand{position:absolute;left:6%;bottom:7%;z-index:2;display:flex;align-items:center;justify-content:center;min-width:76px;padding:10px 12px;background:rgba(12,24,20,.64);border:1px solid rgba(255,255,255,.58);box-shadow:0 8px 26px rgba(0,0,0,.18);backdrop-filter:blur(7px)}</style>
