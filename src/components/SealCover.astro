---
const {sealTitle,guest,episodeNumber,color='#315f52',tint='#e7eee9',wide=false,image,priority=false}=Astro.props;const c=Array.from(sealTitle.padEnd(4,' '));
---
<div class:list={['seal',{wide,photo:Boolean(image)}]} style={`--seal:${color};--tint:${tint}`}>
  {image?<><img src={image} alt={`${guest}教授`} loading={priority?'eager':'lazy'} fetchpriority={priority?'high':'auto'} width="1080" height="810"/><div class="photo-shade"></div><div class="photo-label"><span>经邦论策 · 第 {episodeNumber} 期</span><strong>{sealTitle}</strong><small>{guest} · JIANDI INSIGHTS</small></div></>:<svg viewBox="0 0 640 760" role="img" aria-label={`${sealTitle}，${guest}`}><rect width="640" height="760" fill="var(--tint)"/><path d="M56 55h528v650H56zM86 84h468v592H86z" fill="none" stroke="var(--seal)" opacity=".28"/><text x="80" y="120" class="meta">经邦论策 · 第 {episodeNumber} 期</text><g class="title"><text x="246" y="300">{c[0]}</text><text x="394" y="300">{c[1]}</text><text x="246" y="448">{c[2]}</text><text x="394" y="448">{c[3]}</text></g><line x1="226" y1="500" x2="414" y2="500" stroke="var(--seal)"/><text x="320" y="568" class="guest">{guest}</text><text x="320" y="615" class="meta center">JIANDI · INSIGHTS</text><rect x="490" y="622" width="70" height="70" fill="var(--seal)"/><text x="525" y="666" class="mark">见地</text></svg>}
</div>
<style>.seal{position:relative;aspect-ratio:640/760;overflow:hidden;background:var(--tint)}svg{display:block;width:100%;height:100%}.meta{fill:var(--seal);font:500 16px system-ui;letter-spacing:.18em}.center{text-anchor:middle;font-size:12px}.title text{fill:var(--seal);font:600 112px ui-serif,"Songti SC",serif;text-anchor:middle}.guest{fill:var(--seal);font:500 30px ui-serif,"Songti SC",serif;text-anchor:middle;letter-spacing:.25em}.mark{fill:#fff;font:600 18px ui-serif,"Songti SC",serif;text-anchor:middle}.wide,.photo{aspect-ratio:4/3}.wide:not(.photo) svg{transform:translateY(-10%) scale(.84)}.photo img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}.photo-shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(10,17,15,.82) 100%)}.photo-label{position:absolute;left:0;right:0;bottom:0;padding:9% 9% 7%;color:#fff;display:flex;flex-direction:column;text-shadow:0 1px 16px rgba(0,0,0,.35)}.photo-label span,.photo-label small{font:600 10px/1.4 ui-sans-serif,system-ui;letter-spacing:.16em;text-transform:uppercase;opacity:.82}.photo-label strong{margin:5px 0 3px;font:600 clamp(25px,4vw,43px)/1.15 ui-serif,"Songti SC",serif;letter-spacing:.12em}.photo-label small{font-size:9px;letter-spacing:.11em}.wide .photo-label strong{font-size:clamp(24px,3vw,36px)}</style>
