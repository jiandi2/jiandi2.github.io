---
import BrandMark from './BrandMark.astro';
import {isEnglishPath} from '../lib/locale';
const en = isEnglishPath(Astro.url.pathname);
const href = en ? '/en/interviews#season-two' : '/interviews/#season-two';
---
<section class="season-two-preview" id="season-two" aria-label={en ? 'Season Two preview' : '第二季预告'}>
  <div class="season-copy">
    <p class="eyebrow">{en ? 'Season Two' : '第二季预告'}</p>
    <h2>{en ? 'The conversation continues — in Chinese and in English' : '继续追问，学问如何成为一种人生'}</h2>
    {en ? (
      <p>Season Two follows the same three questions: origin, craft, and judgment. Some conversations will be in Chinese; some will be in English. The language of the talk is the language of the record.</p>
    ) : (
      <p>第二季将沿着学者的来路，进入研究的手艺，也抵达由经验与思考沉淀而成的见识。部分对话将以中文进行，部分将以英语进行；对话用什么语言，完整记录就用什么语言。</p>
    )}
    <a class="text-link" href={href}>{en ? 'See the Season Two preview →' : '查看第二季预告 →'}</a>
  </div>
  <a class="season-poster" href={href} aria-label={en ? 'Season Two: origin, craft, judgment' : '第二季敬请期待：来路、手艺、见识'}>
    <div class="paper-field"><small>第二季</small><div><b>来路</b><i></i><b>手艺</b><i></i><b>见识</b></div></div>
    <div class="season-panel"><span>经邦论策</span><div class="panel-title"><b>敬</b><b>请</b><b>期</b><b>待</b></div><i></i><small>第二季</small><em>COMING SOON</em></div>
    <div class="poster-brand"><BrandMark stacked compact/></div>
  </a>
</section>
<style>
.season-two-preview{width:var(--wide);margin:112px auto;display:grid;grid-template-columns:minmax(0,.85fr) minmax(430px,1.15fr);gap:clamp(48px,8vw,100px);align-items:center}.season-copy h2{max-width:9em;margin:.25em 0 .55em;font:600 clamp(34px,4vw,52px)/1.3 var(--display,ui-serif);letter-spacing:.01em}.season-copy>p:not(.eyebrow){max-width:29em;color:var(--muted);font-family:var(--body-serif,ui-serif);font-size:18px;line-height:1.9}.season-copy .text-link{display:inline-block;margin-top:12px}.season-poster{position:relative;aspect-ratio:4/3;overflow:hidden;background:#f3ead6;box-shadow:var(--shadow);transition:transform .22s ease,box-shadow .22s ease}.season-poster:after{content:"";position:absolute;inset:16px;border:1px solid rgba(92,78,51,.34);pointer-events:none}.paper-field{position:absolute;inset:0 34% 0 0;color:#4c5751;background:radial-gradient(circle at 48% 45%,rgba(255,255,255,.58),transparent 33%),linear-gradient(145deg,#f7efdf,#eee1c8);display:flex;align-items:center;justify-content:center}.paper-field:after{content:"";position:absolute;width:55%;aspect-ratio:1;border:1px solid rgba(149,107,36,.17);border-radius:50%}.paper-field>small{position:absolute;top:8%;left:9%;font:650 9px/1.4 var(--ui,ui-sans-serif);letter-spacing:.22em;color:#6b726d}.paper-field>div{position:relative;z-index:1;display:flex;align-items:center;gap:clamp(9px,1.5vw,18px)}.paper-field b{font:600 clamp(24px,3.1vw,39px)/1.1 var(--display,ui-serif);letter-spacing:.08em}.paper-field i{width:4px;height:4px;border-radius:50%;background:#9a793f}.season-panel{position:absolute;inset:0 0 0 66%;padding:8% 5.5%;background:#956b24;color:#f3ead6;display:flex;flex-direction:column;align-items:center;justify-content:center}.season-panel>span,.season-panel>small{font:600 9px/1.4 var(--ui,ui-sans-serif);letter-spacing:.22em;opacity:.8}.panel-title{display:grid;grid-template-columns:repeat(2,1fr);gap:.05em .17em;margin:12% 0;color:#fff}.panel-title b{font:600 clamp(22px,3.5vw,46px)/1.05 var(--display,ui-serif)}.season-panel>i{width:30px;margin:2% 0 9%;border-top:1px solid rgba(255,255,255,.55)}.season-panel em{margin-top:9%;color:#fff;font:650 clamp(8px,.85vw,11px)/1.2 var(--ui,ui-sans-serif);font-style:normal;letter-spacing:.13em}.poster-brand{position:absolute;left:7%;bottom:8%;z-index:2;color:#3b4943}.season-poster:hover{transform:translateY(-4px);box-shadow:0 22px 58px rgba(27,43,37,.16)}@media(max-width:850px){.season-two-preview{grid-template-columns:1fr;gap:32px}.season-copy h2{max-width:13em}}@media(max-width:640px){.season-two-preview{margin:72px auto;gap:26px}.season-copy h2{font-size:31px}.season-copy>p:not(.eyebrow){font-size:16.5px}.season-poster{width:calc(100% + 32px);margin-left:-16px;box-shadow:none}.season-poster:hover{transform:none}.paper-field b{font-size:clamp(22px,7vw,31px)}}
</style>
