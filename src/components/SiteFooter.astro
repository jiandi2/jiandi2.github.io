---
import BrandMark from './BrandMark.astro';
import {isEnglishPath} from '../lib/locale';
const en = isEnglishPath(Astro.url.pathname);
const home = en ? '/en' : '/';
---
<footer class="site-footer">
  <div>
    <a href={home} aria-label={en ? 'Insights home' : '见地首页'}><BrandMark/></a>
    <p>{en ? 'Conversations with economists on judgment, craft, and the making of a life in research.' : '与经济学家谈学问、时代与选择。'}</p>
  </div>
  <div>
    {en ? (
      <>
        <p>Jingbang Lunce is produced by the Chinese Economists Society.</p>
        <p>Internal preview.</p>
      </>
    ) : (
      <>
        <p>《经邦论策》由中国留美经济学会出品</p>
        <p>内部测试版</p>
      </>
    )}
  </div>
</footer>
