---
import BaseLayout from './BaseLayout.astro';const {entry,episode,previous,next}=Astro.props;
---
<BaseLayout title={entry.data.title} description={entry.data.dek}><header class="reading-head"><a class="back" href={`/interviews/${episode.id}`}>← {episode.data.guest}访谈</a><p class="eyebrow">第 {episode.data.episodeNumber} 期 · {episode.data.sealTitle} · {entry.data.partName}</p><h1>「{entry.data.title}」</h1><p class="reading-dek">{entry.data.dek}</p><div class="byline"><span>嘉宾：{episode.data.guest}教授</span><span>主持：冯志钢教授</span><span>中国留美经济学会出品</span></div></header><article class="reading-body"><slot/></article><nav class="part-nav">{previous?<a href={`/interviews/${episode.id}/${previous.data.part}`}><small>上一篇 · {previous.data.partName}</small><b>「{previous.data.title}」</b></a>:<span/>}{next?<a class="next" href={`/interviews/${episode.id}/${next.data.part}`}><small>下一篇 · {next.data.partName}</small><b>「{next.data.title}」</b></a>:<a class="next" href={`/interviews/${episode.id}`}><small>返回本期</small><b>查看完整目录</b></a>}</nav></BaseLayout>
