---
import {getCollection} from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import EpisodeCard from '../components/EpisodeCard.astro';import SubscribeBand from '../components/SubscribeBand.astro';const episodes=(await getCollection('episodes')).sort((a,b)=>b.data.episodeNumber-a.data.episodeNumber);const latest=episodes[0];
---
<BaseLayout><Hero episode={latest}/><section class="section"><div class="section-head"><div><p class="eyebrow">访谈档案</p><h2>与经济学家，谈问题也谈来路</h2></div><a class="text-link" href="/interviews">查看全部 →</a></div><div class="grid archive-grid">{episodes.map(episode=><EpisodeCard href={`/interviews/${episode.id}`} eyebrow={`第 ${episode.data.episodeNumber} 期 · ${episode.data.sealTitle}`} title={episode.data.title} summary={episode.data.summary} sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint} portrait={episode.data.portrait}/>)}</div></section><section class="manifesto"><p class="eyebrow">为什么是见地</p><blockquote>“不只记录结论，也追问一项研究从哪里来，一个判断如何形成。”</blockquote><p>这里保存《经邦论策》的完整访谈，也刊登主持人在访谈之外的观察与思考。</p></section><SubscribeBand/></BaseLayout>
