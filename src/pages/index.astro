---
import {getCollection,getEntry} from 'astro:content';import BaseLayout from '../layouts/BaseLayout.astro';import Hero from '../components/Hero.astro';import EpisodeCard from '../components/EpisodeCard.astro';import SubscribeBand from '../components/SubscribeBand.astro';const episode=await getEntry('episodes','bai');if(!episode)throw new Error('missing episode');const parts=(await getCollection('parts')).sort((a,b)=>a.data.part-b.data.part);
---
<BaseLayout><Hero episode={episode}/><section class="section"><div class="section-head"><div><p class="eyebrow">最新连载</p><h2>一场深谈，三个入口</h2></div><a class="text-link" href="/interviews">全部访谈 →</a></div><div class="grid">{parts.map(p=><EpisodeCard href={`/interviews/bai/${p.data.part}`} eyebrow={`白艳 · ${p.data.partName}`} title={`「${p.data.title}」`} summary={p.data.dek} sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint}/>)}</div></section><section class="manifesto"><p class="eyebrow">为什么是见地</p><blockquote>“不只记录结论，也追问一项研究从哪里来，一个判断如何形成。”</blockquote><p>这里保存《经邦论策》的完整访谈，也刊登主持人在访谈之外的观察与思考。</p></section><SubscribeBand/></BaseLayout>
