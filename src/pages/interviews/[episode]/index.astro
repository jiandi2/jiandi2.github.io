---
import {getCollection} from 'astro:content';import BaseLayout from '../../../layouts/BaseLayout.astro';import SealCover from '../../../components/SealCover.astro';import EpisodeCard from '../../../components/EpisodeCard.astro';export async function getStaticPaths(){return(await getCollection('episodes')).map(episode=>({params:{episode:episode.id},props:{episode}}))}const {episode}=Astro.props;const parts=(await getCollection('parts')).filter(p=>p.data.episode.id===episode.id).sort((a,b)=>a.data.part-b.data.part);
---
<BaseLayout title={`${episode.data.guest}：${episode.data.sealTitle}`}><section class="episode-intro"><div class="episode-cover"><SealCover sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint}/></div><div><p class="eyebrow">第一季 · 第 {episode.data.episodeNumber} 期</p><h1>{episode.data.guest}<small>{episode.data.guestEn}</small></h1><p class="lead">{episode.data.summary}</p><p>{episode.data.affiliation}</p><div class="tags">{episode.data.fields.map((f:string)=><span>{f}</span>)}</div></div></section><section class="section"><div class="section-head"><div><p class="eyebrow">三集连载</p><h2>来路、手艺与见识</h2></div><a class="text-link" href={`/interviews/${episode.id}/full`}>全文版（即将上线） →</a></div><div class="grid">{parts.map(p=><EpisodeCard href={`/interviews/${episode.id}/${p.data.part}`} eyebrow={`第 ${p.data.part} 集 · ${p.data.partName}`} title={`「${p.data.title}」`} summary={p.data.dek} sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint}/>)}</div></section></BaseLayout>
