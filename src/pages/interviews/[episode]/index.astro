---
import {getCollection} from 'astro:content';import BaseLayout from '../../../layouts/BaseLayout.astro';import SealCover from '../../../components/SealCover.astro';import EpisodeCard from '../../../components/EpisodeCard.astro';export async function getStaticPaths(){return(await getCollection('episodes')).map(episode=>({params:{episode:episode.id},props:{episode}}))}const {episode}=Astro.props;const parts=(await getCollection('parts')).filter(p=>p.data.episode.id===episode.id).sort((a,b)=>a.data.part-b.data.part);const full=(await getCollection('fulls')).find(entry=>entry.id===episode.id);
---
<BaseLayout title={`${episode.data.guest}：${episode.data.sealTitle}`}><section class="episode-intro"><div class="episode-cover"><SealCover sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint} image={episode.data.portrait} imagePosition={episode.data.portraitPosition} priority/></div><div><p class="eyebrow">第一季 · 第 {episode.data.episodeNumber} 期</p><h1>{episode.data.guest}<small>{episode.data.guestEn}</small></h1><p class="lead">{episode.data.summary}</p><p>{episode.data.affiliation}</p><div class="tags">{episode.data.fields.map((f:string)=><span>{f}</span>)}</div></div></section>{parts.length>0&&<section class="section"><div class="section-head"><div><p class="eyebrow">三集连载</p><h2>来路、手艺与见识</h2></div><a class="text-link" href={`/interviews/${episode.id}/full`}>全文版（即将上线） →</a></div><div class="grid">{parts.map(p=><EpisodeCard href={`/interviews/${episode.id}/${p.data.part}`} eyebrow={`第 ${p.data.part} 集 · ${p.data.partName}`} title={`「${p.data.title}」`} summary={p.data.dek} sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint} portrait={episode.data.portrait} portraitPosition={episode.data.portraitPosition}/>)}</div></section>}{full&&<section class="section"><div class="full-feature"><div><p class="eyebrow">完整访谈 · {full.data.wordCount.toLocaleString('zh-CN')} 字</p><h2>「{full.data.title}」</h2><p>{full.data.dek}</p><a class="button" href={`/interviews/${episode.id}/full`}>阅读完整访谈 →</a></div><aside><b>本期线索</b><ol>{(episode.data.highlights??[]).map((item:string)=><li>{item}</li>)}</ol></aside></div></section>}</BaseLayout>
