---
import {getCollection} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import Hero from '../../components/Hero.astro';import EpisodeCard from '../../components/EpisodeCard.astro';const episodes=(await getCollection('episodes')).sort((a,b)=>b.data.episodeNumber-a.data.episodeNumber);const latest=episodes[0];
---
<BaseLayout title="访谈"><header class="page-intro"><p class="eyebrow">经邦论策 · 访谈档案</p><h1>经济学，不只发生在模型里</h1><p class="lead">从求学的偶然，到研究的手艺，再到对当下的判断。每一期都保留完整上下文。</p></header><div class="filters"><span class="on">全部</span><span>第一季</span><span>宏观经济</span><span>金融</span></div><Hero episode={latest}/><section class="section archive-section"><div class="section-head"><div><p class="eyebrow">全部期次 · {episodes.length} 场对话</p><h2>按时间倒序</h2></div></div><div class="grid archive-grid">{episodes.map(episode=><EpisodeCard href={`/interviews/${episode.id}`} eyebrow={`第 ${episode.data.episodeNumber} 期 · ${episode.data.sealTitle}`} title={episode.data.title} summary={episode.data.summary} sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint} portrait={episode.data.portrait} portraitPosition={episode.data.portraitPosition}/>)}</div></section></BaseLayout>
