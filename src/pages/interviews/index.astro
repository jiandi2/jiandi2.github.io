---
import {getCollection} from 'astro:content';import SeasonTwoTeaser from '../../components/SeasonTwoTeaser.astro';import BaseLayout from '../../layouts/BaseLayout.astro';import Hero from '../../components/Hero.astro';import EpisodeCard from '../../components/EpisodeCard.astro';const episodes=(await getCollection('episodes')).sort((a,b)=>b.data.episodeNumber-a.data.episodeNumber);const latest=episodes[0];const fields=[...new Set(episodes.flatMap(episode=>episode.data.fields))].sort((a,b)=>a.localeCompare(b,'zh-CN'));
---
<BaseLayout title="访谈"><header class="page-intro"><p class="eyebrow">经邦论策 · 访谈档案</p><h1>经济学，不只发生在模型里</h1><p class="lead">从求学的偶然，到研究的手艺，再到对当下的判断。每一期都保留完整上下文。</p></header><nav class="filters" aria-label="按研究领域筛选"><a class="on" href="/interviews/" data-field="">全部</a>{fields.map(field=><a href={`/interviews/?field=${encodeURIComponent(field)}`} data-field={field}>{field}</a>)}</nav><Hero episode={latest}/><SeasonTwoTeaser/><section class="section archive-section"><div class="section-head"><div><p class="eyebrow">访谈索引 · <span data-result-count>{episodes.length}</span> 场对话</p><h2>按时间倒序</h2></div></div><div class="grid archive-grid">{episodes.map(episode=><EpisodeCard href={`/interviews/${episode.id}`} eyebrow={`第 ${episode.data.episodeNumber} 期 · ${episode.data.sealTitle}`} title={episode.data.title} summary={episode.data.summary} sealTitle={episode.data.sealTitle} guest={episode.data.guest} episodeNumber={episode.data.episodeNumber} color={episode.data.sealColor} tint={episode.data.sealTint} portrait={episode.data.portrait} portraitPosition={episode.data.portraitPosition} portraitScale={episode.data.portraitScale} fields={episode.data.fields}/>)}</div></section><p class="filter-empty" hidden>暂时没有这一领域的访谈。</p><script>
const params=new URLSearchParams(window.location.search);const requested=params.get('field')??'';const links=Array.from(document.querySelectorAll<HTMLAnchorElement>('.filters [data-field]'));const cards=Array.from(document.querySelectorAll<HTMLElement>('.archive-section .card[data-fields]'));const available=new Set(links.map(link=>link.dataset.field??''));const active=available.has(requested)?requested:'';links.forEach(link=>{const on=(link.dataset.field??'')===active;link.classList.toggle('on',on);if(on)link.setAttribute('aria-current','page');else link.removeAttribute('aria-current')});let visible=0;cards.forEach(card=>{const topics=JSON.parse(card.dataset.fields??'[]') as string[];const show=!active||topics.includes(active);card.hidden=!show;if(show)visible++});const count=document.querySelector<HTMLElement>('[data-result-count]');if(count)count.textContent=String(visible);const empty=document.querySelector<HTMLElement>('.filter-empty');if(empty)empty.hidden=visible!==0;
</script></BaseLayout>
