---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="订阅见地">
  <section class="status subscribe-page">
    <p class="eyebrow">来信订阅</p>
    <h1>下一场深谈，来信相见</h1>
    <p class="subscribe-dek">新访谈发布时，来信相告。</p>
    <div class="beehiiv-form" aria-label="见地邮件订阅表单">
      <script is:inline async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="5e2e6599-edc7-4e37-a24e-2e0598a012c7"></script>
      <noscript>请启用 JavaScript 以显示订阅表单。</noscript>
    </div>
    <p class="privacy-note">订阅采用双重确认。提交后，请前往邮箱点击确认链接；你可以随时退订。</p>
    <a class="text-link" href="/interviews">先读一期访谈 →</a>
  </section>
</BaseLayout>

<style>
.subscribe-page{max-width:760px}.subscribe-dek{max-width:33em;margin:0 auto;color:var(--muted);font-family:var(--body-serif,ui-serif);font-size:18px;line-height:1.9}.beehiiv-form{height:0;margin:0;overflow:visible}.beehiiv-form noscript{display:block;margin:24px auto;color:var(--muted);font-size:14px}.privacy-note{max-width:42em;margin:28px auto;color:var(--muted);font-size:12px;line-height:1.7}@media(max-width:640px){.subscribe-dek{font-size:16.5px}}
</style>
